{
  "name": "@biziva/router",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "BYOK multimodal gateway with native developer protocols and explicit cost controls",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs --onboard",
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/server.mjs",
    "setup": "node scripts/setup.mjs",
    "desktop": "node src/server.mjs --desktop",
    "build:desktop": "node scripts/build-desktop.mjs",
    "smoke:desktop": "node scripts/smoke-desktop.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6"
  }
}
